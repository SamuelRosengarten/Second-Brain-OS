# Copy to .env.local and adjust. Placeholders only - never commit real secrets.

# Where ALL user data lives (database, vault, attachments, backups). Keep it outside the repo.
# Default: ~/SecondBrainOS
SBOS_DATA_DIR=

# Secret used to sign session cookies (>= 32 chars). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SBOS_SESSION_SECRET=change-me-generate-a-long-random-string

# Ollama (keep it bound to localhost - never expose port 11434)
OLLAMA_URL=http://127.0.0.1:11434
SBOS_CHAT_MODEL=qwen3.5:9b
SBOS_EMBED_MODEL=nomic-embed-text

# Extra browser origins allowed to POST (e.g. your Tailscale HTTPS name), comma separated.
SBOS_ALLOWED_ORIGINS=

# Set to 1 only when served over HTTPS (Tailscale Serve) so cookies get the Secure flag.
SBOS_SECURE_COOKIES=0

# Upload limit in MB
SBOS_MAX_UPLOAD_MB=25

# Optional: lets an iPhone Shortcut (share sheet) add to the inbox via POST /api/share. It can ONLY create captures.
# Leave empty to disable. Generate (>= 32 chars) with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SBOS_CAPTURE_TOKEN=

# Optional: passphrase that encrypts backups made with `npm run backup -- --encrypt` (AES-256-GCM).
# Lose it and encrypted backups cannot be opened. Keep a copy somewhere other than this PC.
SBOS_BACKUP_PASSPHRASE=
